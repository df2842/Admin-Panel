# Same Supabase project as the Caption Arena app (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Same Google OAuth client as the Caption Arena app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional: enables "Generate jokes with AI" when creating media (Google AI Studio, free tier)
GEMINI_API_KEY=AIza...
